#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_MAJOR="${NODE_MAJOR:-24}"

log() { printf '\033[1;34m=>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
has() { command -v "$1" >/dev/null 2>&1; }

platform() {
  case "$(uname -s)" in
    Darwin) echo macos ;;
    Linux) echo linux ;;
    *) echo unknown ;;
  esac
}

backup_path() {
  printf '%s.backup.%s' "$1" "$(date +%Y%m%d-%H%M%S)"
}

install_managed_file_if_missing_or_same() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if [ ! -e "$dest" ]; then
    cp "$src" "$dest"
    printf '✓ installed %s\n' "${dest/#$HOME/~}"
    return
  fi
  if cmp -s "$src" "$dest"; then
    return
  fi
  warn "preserving existing ${dest/#$HOME/~}; managed version changed at ${src#$ROOT/}"
}

install_managed_file_with_backup() {
  local src="$1" dest="$2" backup
  mkdir -p "$(dirname "$dest")"
  if [ -e "$dest" ] && ! cmp -s "$src" "$dest"; then
    backup="$(backup_path "$dest")"
    cp "$dest" "$backup"
    warn "backed up existing ${dest/#$HOME/~} to ${backup/#$HOME/~}"
  fi
  cp "$src" "$dest"
}

ensure_gitconfig_include() {
  local gitconfig="$HOME/.gitconfig"
  local include_path="$HOME/.config/dotfiles/gitconfig"
  local tmp
  mkdir -p "$HOME/.config/dotfiles"
  touch "$gitconfig"
  if git config --file "$gitconfig" --get-all include.path 2>/dev/null | grep -Fxq "$include_path"; then
    return
  fi

  log "Adding dotfiles include to ~/.gitconfig"
  tmp="$(mktemp -t dot-gitconfig.XXXXXX)"
  if [ -f "$ROOT/home/.gitconfig" ] && cmp -s "$ROOT/home/.gitconfig" "$gitconfig"; then
    printf '[include]\n\tpath = %s\n' "$include_path" >"$tmp"
  else
    {
      printf '[include]\n\tpath = %s\n\n' "$include_path"
      cat "$gitconfig"
    } >"$tmp"
  fi
  mv "$tmp" "$gitconfig"
}

ensure_ssh_include() {
  local ssh_config="$HOME/.ssh/config"
  local include_line="Include ~/.config/dotfiles/ssh_config"
  local tmp backup
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh" 2>/dev/null || true
  if [ ! -e "$ssh_config" ] && [ ! -L "$ssh_config" ]; then
    : >"$ssh_config"
  fi
  chmod 600 "$ssh_config" 2>/dev/null || true
  # Prepend the Include: in ssh_config the earliest value for a keyword wins,
  # so managed Host blocks must be read before any later "Host *" catch-all.
  if grep -Fxq "$include_line" "$ssh_config" 2>/dev/null; then
    return
  fi

  log "Adding dotfiles Include to ~/.ssh/config"
  if [ -s "$ssh_config" ] || [ -L "$ssh_config" ]; then
    backup="$(backup_path "$ssh_config")"
    if cp "$ssh_config" "$backup" 2>/dev/null; then
      warn "backed up existing ${ssh_config/#$HOME/~} to ${backup/#$HOME/~}"
    fi
  fi
  tmp="$(mktemp -t dot-sshconfig.XXXXXX)"
  {
    printf '%s\n\n' "$include_line"
    cat "$ssh_config"
  } >"$tmp"
  # Write through the path instead of renaming over it, so a symlinked
  # ~/.ssh/config remains a symlink to the user's chosen config file.
  cat "$tmp" >"$ssh_config"
  rm -f "$tmp"
  chmod 600 "$ssh_config" 2>/dev/null || true
}

ensure_shell_hook() {
  local rc="$1"
  local hook='[ -f "$HOME/.config/dotfiles/shell.sh" ] && . "$HOME/.config/dotfiles/shell.sh"'
  mkdir -p "$(dirname "$rc")"
  touch "$rc"
  if ! grep -Fq '.config/dotfiles/shell.sh' "$rc"; then
    log "Adding dotfiles shell hook to ${rc/#$HOME/~}"
    {
      printf '\n# dotfiles shell bootstrap\n'
      printf '%s\n' "$hook"
    } >>"$rc"
  fi
}

install_shell_hooks() {
  log "Installing shell PATH hooks"
  ensure_shell_hook "$HOME/.profile"
  ensure_shell_hook "$HOME/.bashrc"
  if [ -n "${ZDOTDIR:-}" ]; then
    ensure_shell_hook "$ZDOTDIR/.zshrc"
  else
    ensure_shell_hook "$HOME/.zshrc"
  fi
}

sync_configs() {
  log "Syncing managed configs"
  if ! has rsync; then
    warn "rsync missing; cannot sync managed directories"
    return 1
  fi

  mkdir -p "$HOME/.pi" "$HOME/.agents" "$HOME/.claude"
  # Preserve live Pi settings: Pi mutates agent/settings.json for model/theme/packages.
  rsync -a --exclude='.DS_Store' --exclude='agent/settings.json' "$ROOT/home/.pi/" "$HOME/.pi/"
  if [ -f "$ROOT/home/.pi/agent/settings.json" ]; then
    install_managed_file_if_missing_or_same "$ROOT/home/.pi/agent/settings.json" "$HOME/.pi/agent/settings.json"
  fi

  # Merge skills/extensions without --delete to preserve locally-added skills.
  rsync -a --exclude='.DS_Store' "$ROOT/home/.agents/" "$HOME/.agents/"

  if [ -d "$ROOT/home/.config/herdr" ]; then
    mkdir -p "$HOME/.config/herdr"
    rsync -a --exclude='.DS_Store' "$ROOT/home/.config/herdr/" "$HOME/.config/herdr/"
  fi
  if [ -d "$ROOT/home/.config/ghostty" ]; then
    mkdir -p "$HOME/.config/ghostty"
    rsync -a --exclude='.DS_Store' "$ROOT/home/.config/ghostty/" "$HOME/.config/ghostty/"
  fi
  if [ -d "$ROOT/home/.config/dotfiles" ]; then
    mkdir -p "$HOME/.config/dotfiles"
    rsync -a --exclude='.DS_Store' "$ROOT/home/.config/dotfiles/" "$HOME/.config/dotfiles/"
  fi
  if [ -d "$ROOT/home/.config/nvim" ]; then
    mkdir -p "$HOME/.config/nvim"
    rsync -a --exclude='.DS_Store' "$ROOT/home/.config/nvim/" "$HOME/.config/nvim/"
  fi
  if [ -f "$ROOT/home/.gitignore_global" ]; then
    install_managed_file_with_backup "$ROOT/home/.gitignore_global" "$HOME/.gitignore_global"
  fi
  if [ -f "$ROOT/home/.gitconfig" ]; then
    cp "$ROOT/home/.gitconfig" "$HOME/.config/dotfiles/gitconfig"
    ensure_gitconfig_include
  fi
  # SSH aliases: the fragment ships via the .config/dotfiles rsync above; just
  # ensure ~/.ssh/config includes it (without touching existing host entries).
  if [ -f "$ROOT/home/.config/dotfiles/ssh_config" ]; then
    ensure_ssh_include
  fi

  if [ -d "$ROOT/home/.claude/commands" ]; then
    mkdir -p "$HOME/.claude/commands"
    rsync -a --delete --exclude='.DS_Store' "$ROOT/home/.claude/commands/" "$HOME/.claude/commands/"
  fi
  if [ -d "$ROOT/home/.claude/agents" ]; then
    mkdir -p "$HOME/.claude/agents"
    rsync -a --delete --exclude='.DS_Store' "$ROOT/home/.claude/agents/" "$HOME/.claude/agents/"
  fi
}

install_nodesource_linux() {
  if ! has apt-get || ! has sudo; then
    warn "apt-get+sudo unavailable; skipping NodeSource setup"
    return 1
  fi

  log "Configuring NodeSource Node.js ${NODE_MAJOR}.x apt repository"
  sudo apt-get update || return 1
  sudo apt-get install -y ca-certificates curl gnupg || return 1
  sudo mkdir -p /etc/apt/keyrings || return 1
  sudo rm -f /etc/apt/keyrings/nodesource.gpg || return 1
  curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | sudo gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg || return 1
  echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    | sudo tee /etc/apt/sources.list.d/nodesource.list >/dev/null || return 1
}

install_packages() {
  case "$(platform)" in
    macos)
      if ! has brew; then
        warn "Homebrew missing. Install it from https://brew.sh/ then rerun ./dot init."
      else
        log "Installing macOS packages with Homebrew"
        brew bundle --file "$ROOT/packages/Brewfile" || warn "Homebrew bundle failed"
      fi
      ;;
    linux)
      if has apt-get && has sudo; then
        install_nodesource_linux || warn "NodeSource setup failed; continuing with available apt sources"
        log "Installing Linux packages with apt"
        sudo apt-get update || warn "apt-get update failed"
        xargs -a "$ROOT/packages/apt.txt" sudo apt-get install -y || warn "apt package install failed"
        sudo apt-get install -y nodejs || warn "Node.js apt install failed"
      else
        warn "apt-get+sudo unavailable; skipping OS packages"
      fi
      ;;
    *) warn "Unknown platform; skipping OS packages" ;;
  esac
}

install_node_tools() {
  if [ -f "$HOME/.config/dotfiles/shell.sh" ]; then
    # Pick up npm global bin changes made earlier in this process.
    # shellcheck disable=SC1091
    . "$HOME/.config/dotfiles/shell.sh"
  fi

  if ! has npm; then
    warn "npm missing; skipping Pi/Wrangler install"
    return
  fi
  if ! has pi; then
    log "Installing Pi"
    npm install -g --ignore-scripts @earendil-works/pi-coding-agent || warn "Pi install failed"
  fi
  if ! has wrangler; then
    log "Installing Wrangler"
    npm install -g wrangler || warn "Wrangler install failed"
  fi
  if [ -f "$HOME/.config/dotfiles/shell.sh" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.config/dotfiles/shell.sh"
  fi
  if has pi; then
    log "Installing Pi packages"
    pi install npm:pi-web-access || true
    pi install npm:@plannotator/pi-extension || true
  fi
}

install_herdr() {
  if has herdr; then
    log "Herdr already installed: $(command -v herdr)"
    return
  fi

  case "$(platform)" in
    macos)
      if has brew; then
        log "Installing Herdr with Homebrew"
        brew install herdr || warn "Herdr Homebrew install failed"
      else
        warn "Homebrew missing; install Herdr from https://herdr.dev/docs/quick-start/"
      fi
      ;;
    linux)
      log "Installing Herdr with official installer"
      curl -fsSL https://herdr.dev/install.sh | sh || warn "Herdr installer failed"
      ;;
    *) warn "Unknown platform; install Herdr from https://herdr.dev/docs/quick-start/" ;;
  esac
}

install_herdr_integrations() {
  if ! has herdr; then
    warn "Herdr missing; skipping Herdr agent integrations"
    return
  fi

  for integration in pi claude codex; do
    log "Installing Herdr ${integration} integration"
    herdr integration install "$integration" || warn "Herdr ${integration} integration install failed"
  done
}

check_pi_package() {
  local pkg="$1"
  if [ -f "$HOME/.pi/agent/settings.json" ] && grep -Fq "\"$pkg\"" "$HOME/.pi/agent/settings.json"; then
    printf '✓ pi package %s configured\n' "$pkg"
  else
    printf '✗ pi package %s missing from settings\n' "$pkg"
  fi
}

secret_scan() {
  local tmp pattern
  tmp="$(mktemp -t dot-secret-scan.XXXXXX)"
  pattern='(BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY|sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{20,})'
  if git -C "$ROOT" grep -nE "$pattern" -- . ':!.gitignore' >"$tmp" 2>/dev/null; then
    warn "possible tracked secret patterns found:"
    cat "$tmp" >&2
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
  printf '✓ no obvious tracked secret patterns\n'
}

doctor() {
  log "Platform: $(platform)"
  for cmd in git gh node npm pi nvim rg jq wrangler herdr rsync; do
    if has "$cmd"; then printf '✓ %s -> %s\n' "$cmd" "$(command -v "$cmd")"; else printf '✗ %s missing\n' "$cmd"; fi
  done

  if has node; then printf 'node version: %s\n' "$(node --version)"; fi
  if has npm; then printf 'npm version: %s\n' "$(npm --version)"; fi
  if has pi; then printf 'pi version: %s\n' "$(pi --version 2>/dev/null || true)"; fi

  for file in \
    "$HOME/.config/dotfiles/shell.sh" \
    "$HOME/.config/dotfiles/gitconfig" \
    "$HOME/.config/dotfiles/ssh_config" \
    "$HOME/.config/herdr/config.toml" \
    "$HOME/.config/ghostty/config" \
    "$HOME/.config/ghostty/themes/Workshop Neon" \
    "$HOME/.config/nvim/init.lua" \
    "$HOME/.gitconfig" \
    "$HOME/.gitignore_global" \
    "$HOME/.pi/agent/extensions/git-interceptor.ts" \
    "$HOME/.pi/agent/extensions/worker-configuration-guard.ts" \
    "$HOME/.pi/agent/extensions/pi-cloak/index.ts" \
    "$HOME/.pi/agent/cloak.json" \
    "$HOME/.pi/agent/themes/workshop-neon.json" \
    "$HOME/.agents/skills/wayfinder/SKILL.md" \
    "$HOME/.agents/skills/code-review/SKILL.md" \
    "$HOME/.agents/skills/herdr/SKILL.md"; do
    [ -e "$file" ] && printf '✓ %s\n' "${file/#$HOME/~}" || printf '✗ %s missing\n' "${file/#$HOME/~}"
  done

  check_pi_package "npm:pi-web-access"
  check_pi_package "npm:@plannotator/pi-extension"

  if has git; then
    if git config --global --includes user.name >/dev/null && git config --global --includes user.email >/dev/null; then
      printf '✓ git global identity configured\n'
    else
      warn "git global user.name/user.email not set; put machine-specific identity in ~/.gitconfig.local"
    fi
  fi

  if has herdr; then
    herdr integration status 2>/dev/null | sed -n '1,4p' || true
  fi

  if has gh && gh auth status >/dev/null 2>&1; then
    gh repo view m-r0che/.dotfiles --json visibility -q '"GitHub repo visibility: " + .visibility' || true
  fi

  secret_scan || true
}

case "${1:-help}" in
  init) install_packages; sync_configs || true; install_shell_hooks; install_node_tools; install_herdr; install_herdr_integrations; doctor ;;
  sync|stow) sync_configs; install_shell_hooks ;;
  doctor) doctor ;;
  install-herdr) install_herdr; install_herdr_integrations ;;
  install-herdr-integrations) install_herdr_integrations ;;
  update) git -C "$ROOT" pull --ff-only || true; sync_configs || true; install_shell_hooks; has pi && pi update --all || true; install_herdr_integrations; doctor ;;
  help|-h|--help)
    cat <<USAGE
Usage: ./dot <command>

Commands:
  init                        Install packages, sync configs, install tools, run doctor
  sync                        Sync managed configs and shell hooks into home directory
  stow                        Alias for sync (configs are merged with rsync for safety)
  doctor                      Check expected tools, files, integrations, and obvious leaks
  install-herdr               Install Herdr and Pi/Claude/Codex integrations
  install-herdr-integrations  Install Herdr agent integrations only
  update                      Pull repo, sync configs, run pi update --all

Environment:
  NODE_MAJOR=24               NodeSource major version used on Linux apt systems
USAGE
    ;;
  *) echo "Unknown command: $1" >&2; exit 2 ;;
esac
